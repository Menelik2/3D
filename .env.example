# META Pictures — Environment Variables
# Copy to .env.local and fill in real values. Never commit secrets.

# Supabase (https://oqipymvqqptjxiaeasgd.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://oqipymvqqptjxiaeasgd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: direct Postgres connection (for migrations / Prisma etc.)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional public contact / social (or manage via site_settings in admin)
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_WHATSAPP=
# NEXT_PUBLIC_CONTACT_EMAIL=hello@metapictures.example
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
