# Email (Resend — https://resend.com)
# 1. Create account → API Keys → create key
# 2. Add RESEND_API_KEY in Vercel → Settings → Environment Variables
# 3. Free tier can only send TO your Resend account email until you verify a domain
RESEND_API_KEY=
EMAIL_NOTIFY_TO=Metapictures23@gmail.com
# After verifying a domain in Resend, set e.g. META Pictures <hello@yourdomain.com>
EMAIL_FROM=META Pictures <onboarding@resend.dev>

# Optional public contact / social (or manage via site_settings in admin)
