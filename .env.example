# META Pictures — Environment Variables
# Copy to .env.local and fill in real values. Never commit secrets.

# Supabase (https://oqipymvqqptjxiaeasgd.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://oqipymvqqptjxiaeasgd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
# Dashboard → Project Settings → API → service_role (secret)
# Must be a JWT starting with eyJ — do not prefix extra characters.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection (for migrations / Prisma etc.)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Email (Resend — https://resend.com)
# 1. Create account → API Keys → create key
# 2. Add RESEND_API_KEY in Vercel → Settings → Environment Variables
# 3. Free tier can only send TO your Resend account email until you verify a domain
RESEND_API_KEY=re_xxxxxxxx
EMAIL_NOTIFY_TO=Metapictures23@gmail.com
# After verifying a domain in Resend, set e.g. META Pictures <hello@yourdomain.com>
EMAIL_FROM=META Pictures <onboarding@resend.dev>

# Optional public contact / social (or manage via site_settings in admin)
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=Metapictures23@gmail.com
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
